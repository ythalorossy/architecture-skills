#!/bin/bash
# Fake mmdc that succeeds and writes expected SVG files to the output directory

OUTPUT_DIR=""
INPUT_FILE=""

while [[ $# -gt 0 ]]; do
    case $1 in
        -i)
            INPUT_FILE="$2"
            shift 2
            ;;
        -o)
            OUTPUT_DIR="$2"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if [[ -z "$INPUT_FILE" || ! -f "$INPUT_FILE" ]]; then
    # No input file: nothing to do
    :
elif grep -q '%%=~=~' "$INPUT_FILE"; then
    # Batch mode: input contains %%=~=~ markers
    TARGET_DIR="${OUTPUT_DIR:-.}"
    for stem in $(awk -F'%%=~=~' '{print $2}' "$INPUT_FILE" | awk -F'=~=~%%' '{print $1}' | grep -v '^$'); do
        echo "fake svg for $stem" > "${TARGET_DIR}/${stem}.svg"
    done
else
    # Per-diagram mode: plain mmd file
    stem=$(basename "$INPUT_FILE" .mmd)
    echo "fake svg for $stem" > "${OUTPUT_DIR}/${stem}.svg"
fi

exit 0
